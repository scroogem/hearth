{
  "schemaVersion": 1,
  "id": "hearth",
  "version": "${version}",
  "name": "Hearth",
  "description": "Shared Minecraft worlds without a server: the world lives in a git repo, whoever plays hosts it.",
  "license": [
    "MIT",
    "Apache-2.0",
    "LicenseRef-Steamworks-SDK"
  ],
  "icon": "assets/hearth/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "hearth.mc.HearthClient"
    ],
    "e4steam": [
      "hearth.mc.HearthSteamAddon"
    ]
  },
  "mixins": [
    "hearth.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "e4steam": ">=0.3.2"
  }
}
